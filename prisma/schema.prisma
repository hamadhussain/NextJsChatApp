generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  email String @unique
}


model UserIdentity {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique // Unique user ID
  name   String // Name of the user
  token  String
}
